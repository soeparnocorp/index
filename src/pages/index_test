---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="id">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="bg-gradient-to-br from-black to-gray-950 text-white min-h-screen">
        <Header />

        <main class="flex flex-col items-center justify-center px-6 py-20 text-center">
            <h1 class="text-6xl md:text-8xl font-extrabold mb-6 tracking-tight">
                {SITE_TITLE}
            </h1>
            <p class="text-xl md:text-2xl mb-12 max-w-3xl opacity-90">
                {SITE_DESCRIPTION}  
                Buat profile card personal loe ala Linktree. Akses: <strong>readtalk.pages.dev/@username-loe</strong>
            </p>

            <!-- Contoh link atau ajakan -->
            <div class="flex flex-col sm:flex-row gap-6">
                <a
                    href="https://profile.soeparnocorp.workers.dev"
                    class="bg-indigo-600 hover:bg-indigo-700 px-10 py-5 rounded-full text-xl font-bold shadow-lg transition transform hover:scale-105"
                >
                    Buat Profile Gue Sekarang
                </a>
                <a
                    href="https://readtalk.pages.dev/@soeparnocorp"
                    class="border border-white hover:bg-white/10 px-10 py-5 rounded-full text-xl font-bold transition"
                >
                    Lihat Contoh Profile
                </a>
            </div>

            <p class="mt-16 text-sm opacity-70">
                Share link profile loe ke mana aja • Dibuat dengan READTalk Messenger
            </p>
        </main>

        <Footer />
    </body>
</html>
