---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const { username } = Astro.params;
const cleanUsername = username.toLowerCase();

// Fetch data dari Worker Next.js (ganti URL kalau Worker loe beda)
const res = await fetch(`https://profile.soeparnocorp.workers.dev/api/profile/${cleanUsername}`);
const profile = await res.json();

if (!profile || !profile.name) {
  // Redirect ke 404 kalau profile nggak ditemukan
  return Astro.redirect('/404');
}

// Meta SEO & share (Google, OG, Twitter)
const title = `@${cleanUsername} | ${SITE_TITLE}`;
const description = profile.bio || 'Profile card personal ala Linktree';
const ogImage = profile.avatar_url || '/default-avatar.png';  // tambah default image di public/
---

<!doctype html>
<html lang="id">
    <head>
        <BaseHead title={title} description={description} />
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:url" content={`https://readtalk.pages.dev/${username}`} />
        <meta property="og:type" content="profile" />
        <meta name="twitter:card" content="summary_large_image" />
    </head>
    <body class="bg-black text-white min-h-screen flex flex-col">
        <Header />

        <main class="flex-1 flex flex-col items-center py-16 px-6">
            <!-- Avatar -->
            {profile.avatar_url ? (
                <img src={profile.avatar_url} alt={profile.name} class="w-32 h-32 md:w-48 md:h-48 rounded-full border-4 border-indigo-500 shadow-2xl mb-6 object-cover" />
            ) : (
                <div class="w-32 h-32 md:w-48 md:h-48 bg-indigo-600 rounded-full flex items-center justify-center text-6xl md:text-8xl font-bold mb-6 shadow-2xl">
                    {cleanUsername[0].toUpperCase()}
                </div>
            )}

            <h1 class="text-5xl md:text-7xl font-bold mb-4">@{cleanUsername}</h1>
            <p class="text-3xl md:text-4xl mb-8">{profile.name}</p>

            {profile.bio && (
                <p class="text-xl md:text-2xl max-w-3xl text-center mb-12 opacity-90">{profile.bio}</p>
            )}

            <div class="w-full max-w-md space-y-5">
                {profile.links?.map(link => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="block bg-gray-800/60 hover:bg-gray-700/80 py-5 rounded-xl text-center text-lg font-medium transition backdrop-blur-sm"
                    >
                        {link.label}
                    </a>
                ))}
            </div>

            <p class="mt-16 text-sm opacity-60 text-center">
                Dibuat dengan READTalk Messenger • Share link ini!
            </p>
        </main>

        <Footer />
    </body>
</html>
