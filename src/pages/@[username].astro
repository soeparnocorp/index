---
import Layout from '../layouts/BlogPost.astro';  // atau nama layout loe (BlogPost.astro dari about.astro)
import DefaultHero from '../assets/blog-placeholder-about.jpg';  // default hero kalau nggak ada avatar

const { username } = Astro.params;
const cleanUsername = username.replace(/^@/, '').toLowerCase();

// Fetch data dari Worker Next.js loe
const res = await fetch(`https://profile.soeparnocorp.workers.dev/api/profile/${cleanUsername}`);
const profile = await res.json();

if (!profile || !profile.name) {
  return Astro.redirect('/404');
}

// Hero image prioritas avatar dari form, fallback ke default
const heroImage = profile.avatar_url || DefaultHero;

// Meta dinamis (biar SEO & share bagus)
const title = `@${cleanUsername} | READTalk Messenger`;
const description = profile.bio || 'Profile card personal ala Linktree';
---

<Layout
  title={title}
  description={description}
  pubDate={new Date(profile.updated_at || new Date())}
  heroImage={heroImage}
>
  <div class="text-center">
    <h1 class="text-5xl md:text-7xl font-bold mb-4">@{cleanUsername}</h1>
    <p class="text-3xl md:text-5xl mb-8">{profile.name}</p>

    {profile.bio && (
      <p class="text-xl md:text-2xl max-w-3xl mx-auto mb-12 opacity-90">{profile.bio}</p>
    )}

    <div class="max-w-md mx-auto space-y-5">
      {profile.links?.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block bg-gray-800/60 hover:bg-gray-700/80 py-5 rounded-xl text-center text-lg font-medium transition backdrop-blur-sm"
        >
          {link.label}
        </a>
      ))}
    </div>

    <p class="mt-16 text-sm opacity-60">
      Dibuat dengan READTalk Messenger • Share link ini ke mana aja!
    </p>
  </div>
</Layout>
