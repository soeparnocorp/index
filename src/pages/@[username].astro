---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

export function getStaticPaths() {
  return [
    { params: { username: 'SoeparnoCorp' } },
    // Tambah username lain nanti
  ];
}

const { username } = Astro.params;

// Data profile (bisa dari file JSON nanti kalau banyak user)
const profiles = {
  SoeparnoCorp: {
    name: 'Soeparno Enterprise',
    bio: 'Entrepreneur | Builder | READTalk Messenger. Building Indonesia\'s next big thing one step at a time.',
    avatar: '/avatar-soeparno.jpg', // Upload gambar ke public/ kalau ada
    links: [
      {
        label: 'Follow on X',
        url: 'https://x.com/SoeparnoCorp',
        icon: 'x' // optional, bisa tambah class icon nanti
      },
      {
        label: 'LinkedIn Profile',
        url: 'https://www.linkedin.com/in/soeparno-enterprise' // ganti kalau ada
      },
      {
        label: 'Portfolio / Projects',
        url: 'https://portfolio-soeparno.pages.dev' // atau link lain
      },
      {
        label: 'Join Inner Circle (Newsletter/Waitlist)',
        url: 'https://readtalk-form-handler.<your-account>.workers.dev', // ← ini link ke Worker loe!
        highlight: true // optional: bikin tombol ini beda warna
      },
      // Tambah link lain sesuka hati
    ]
  }
};

const profile = profiles[username.toLowerCase()] || null;

if (!profile) return Astro.redirect('/404');
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={`@${username} | ${profile.name}`} description={profile.bio} />
    <!-- Tambah Tailwind kalau udah install, atau style manual -->
  </head>
  <body class="bg-black text-white min-h-screen flex flex-col items-center px-6 py-16">
    <Header />

    <main class="max-w-md w-full text-center">
      <!-- Avatar -->
      <div class="w-32 h-32 mx-auto mb-6 rounded-full overflow-hidden border-4 border-indigo-500 shadow-2xl">
        <!-- <img src={profile.avatar} alt={`@${username}`} class="w-full h-full object-cover" /> -->
        <div class="w-full h-full bg-indigo-600 flex items-center justify-center text-6xl font-bold">
          {username[0].toUpperCase()}
        </div>
      </div>

      <h1 class="text-5xl font-bold mb-2">@{username}</h1>
      <p class="text-2xl mb-4">{profile.name}</p>
      <p class="text-lg mb-12 opacity-80">{profile.bio}</p>

      <!-- Links / Buttons -->
      <div class="space-y-4 w-full">
        {profile.links.map(link => (
          <a 
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "block py-5 rounded-xl text-lg font-medium transition backdrop-blur-sm",
              link.highlight 
                ? "bg-indigo-600 hover:bg-indigo-700 shadow-lg" 
                : "bg-gray-800/60 hover:bg-gray-700/80"
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </main>

    <Footer class="mt-auto py-8 text-sm opacity-60" />
  </body>
</html>
