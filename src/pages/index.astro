---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title="READTalk | @username Profile" description="Buat profile card personal ala Linktree di READTalk Messenger" />
  </head>
  <body class="bg-gradient-to-br from-gray-950 to-black text-white min-h-screen flex flex-col">
    <Header />

    <main class="flex-1 flex flex-col items-center justify-center px-6 py-16 text-center">
      <h1 class="text-5xl md:text-7xl font-extrabold mb-6 tracking-tight">
        READTalk Messenger
      </h1>
      <p class="text-xl md:text-2xl mb-12 max-w-2xl opacity-90">
        Buat profile card personal loe dengan mudah. Cukup akses <strong>readtalk.pages.dev/@username-loe</strong>
      </p>

      <div class="w-full max-w-md mb-16">
        <input 
          type="text" 
          placeholder="@username loe" 
          class="w-full p-5 bg-gray-800 border border-gray-700 rounded-xl text-lg focus:outline-none focus:border-indigo-500"
          oninput="this.value = this.value.replace(/\s/g, ''); if (!this.value.startsWith('@')) this.value = '@' + this.value;"
        />
        <a 
          href="#" 
          id="go-btn" 
          class="mt-4 block bg-indigo-600 hover:bg-indigo-700 py-5 rounded-xl text-xl font-bold transition"
          onclick="const uname = document.querySelector('input').value.slice(1); if(uname) window.location.href = `/@${uname}`"
        >
          Lihat Profile
        </a>
      </div>

      <p class="text-sm opacity-70">
        Contoh: readtalk.pages.dev/@SoeparnoCorp
      </p>
    </main>

    <Footer />
  </body>
</html>
